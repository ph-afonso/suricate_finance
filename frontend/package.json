{
  "name": "suricate-finance",
  "version": "0.1.0",
  "description": "Suricate Finance: suas finanças no ritmo do seu salário",
  "productName": "Suricate Finance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "changelog": "node scripts/changelog.mjs",
    "icones": "node scripts/icones.mjs",
    "predev": "npm run changelog",
    "dev": "quasar dev -m pwa",
    "prebuild": "npm run changelog",
    "build": "quasar build -m pwa",
    "verificar:pwa": "node scripts/verificar-pwa.mjs",
    "lint": "eslint src tests scripts",
    "format": "prettier --write \"src/**/*.{js,vue,scss}\" \"tests/**/*.js\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,scss}\" \"tests/**/*.js\"",
    "pretest": "npm run changelog",
    "test": "vitest run",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/nunito": "^5.1.0",
    "@quasar/extras": "^1.16.12",
    "pinia": "^2.2.6",
    "quasar": "2.16.9",
    "register-service-worker": "^1.7.2",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.0.0",
    "@quasar/vite-plugin": "^1.8.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "sass-embedded": "^1.80.6",
    "sharp": "^0.33.5",
    "vitest": "^2.1.4",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
