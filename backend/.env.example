# Copie para backend/.env e ajuste. Nunca suba o .env para o repositório.
APP_ENV=development
# Local sem Postgres: SQLite. Com o Neon: a string de conexão com pool do ramo dev.
DATABASE_URL=sqlite+pysqlite:///./local.db
# Só para migrações no Neon (conexão direta, sem pool)
DATABASE_URL_DIRECT=
# Página de status: "Nome=https://endereço" separados por ";"
STATUS_AMBIENTES=Desenvolvimento local=http://127.0.0.1:8000

# Acesso (M2). Sem SMTP, os e-mails aparecem no log da API (link de redefinir senha).
APP_URL=http://localhost:9001
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
GITHUB_SUGESTOES_TOKEN=
# Senha do usuário 1 fictício no seed (só em development)
SEED_SENHA=
